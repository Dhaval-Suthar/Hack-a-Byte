{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
  "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
  "app/**/*.ts",
  "app/**/*.tsx",
  "pages/**/*.ts",
  "pages/**/*.tsx",
  "components/**/*.ts",
  "components/**/*.tsx",
  "hooks/**/*.ts",
  "hooks/**/*.tsx",
  "lib/**/*.ts",
  "lib/**/*.tsx",
  "types/**/*.ts",
  "types/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "external-socket-server/**/*",
    "coverage/**/*"
  ]
}
