{
  "functions": {
    "app/layout.tsx": {
      "includeFiles": "public/**"
    }
  },
  "headers": [
    {
      "source": "/hackbook-w95/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/socketio",
      "destination": "/api/socketio"
    }
  ]
}
